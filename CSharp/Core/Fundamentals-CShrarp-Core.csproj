<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  
    <PackageId>Fundamentals</PackageId>
    <Title>Fundamentals</Title>
    <Description>Fundamental constants and enumerations</Description>
    <Version>11.0.0-alpha.1</Version>
    <RepositoryUrl>https://github.com/TokugawaTakeshi/CSharp-Fundamentals.git</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <RootNamespace>Fundamentals</RootNamespace>
    
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>15</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>